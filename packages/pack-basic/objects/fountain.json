        }
      },
      "effects": [
        {
          "block": "changeState",
          "target": "held",
          "set": {
            "water": 1
          }
        },
        {
          "block": "observe",
          "text": "the can filled up with cold water"
        }
      ],
      "fail": "you need to be holding a watering can to fill it"
    },
    "scan": {
      "range": 6,
      "durationSeconds": 20,
      "effects": [
        {
          "block": "handler",
          "name": "basic.inspect"
        }
      ]
    }
  },
  "appearance": {
    "flowing": [
      {
        "lt": 1,
        "text": "the fountain is dry"
      },
      {
        "text": "water splashes in the fountain"
      }
    ]
  }
