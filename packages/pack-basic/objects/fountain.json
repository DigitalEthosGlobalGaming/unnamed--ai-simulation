{
  "schema": 2,
  "id": "fountain",
  "name": "Fountain",
  "description": "Cool water. Fills a watering can.",
  "icon": "<icon><ellipse cx=\"12\" cy=\"18\" rx=\"9\" ry=\"3\"/><line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"8\" weight=\"heavy\"/><path d=\"M 12 8 A 4 4 0 0 1 18 12\" dashed=\"true\"/><path d=\"M 12 8 A 4 4 0 0 0 6 12\" dashed=\"true\"/></icon>",
  "tags": [
    "water",
    "loud"
  ],
  "solid": true,
  "state": {
    "flowing": {
      "initial": 1,
      "min": 0,
      "max": 1
    }
  },
  "verbs": {
    "rinse": {
      "range": 1,
      "durationSeconds": 30,
      "effects": [
        {
          "block": "handler",
          "name": "basic.rinse"
        }
      ]
    },
    "splash": {
      "range": 1,
      "durationSeconds": 15,
      "boredomStep": 0.35,
      "effects": [
        {
          "block": "handler",
          "name": "basic.splash"
        }
      ]
    },
    "fill": {
      "range": 1,
      "durationSeconds": 8,
      "requires": {
