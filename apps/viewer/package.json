{
  "name": "@uas/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unnamed AI Simulation viewer: blueprint world scene, inspector and brain feed, on @uas/client (or an offline sample with ?source=sample).",
  "scripts": {
