  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@uas/client": "0.1.0",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
