{
  "name": "unnamed-ai-simulation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "smoke:ollama": "node packages/models/scripts/smoke-ollama.ts",
    "ollama:up": "sh scripts/ollama-up.sh",
    "ollama:pull": "sh scripts/ollama-pull.sh",
    "start": "node --env-file-if-exists=.env packages/server/src/main.ts",
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs",
    "dev:fake": "node scripts/dev.mjs --fake",
    "bakeoff": "node --env-file-if-exists=.env packages/models/scripts/bakeoff.ts",
    "smoke:gateway": "node --env-file-if-exists=.env packages/models/scripts/smoke-gateway.ts",
    "eval": "node --env-file-if-exists=.env packages/evals/scripts/eval.ts",
    "eval:capture": "node --env-file-if-exists=.env packages/evals/scripts/capture.ts",
    "world:archive": "node packages/server/scripts/world.ts archive",
    "world:new": "node packages/server/scripts/world.ts new",
    "prompts:export": "node packages/server/scripts/prompts-export.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
