# Copy to .env (never commit it). Every value is optional.

# --- Server
PORT=8080
# SQLite file (WAL mode). Postgres is not wired up yet.
UAS_DB=data/uas.db
# Directory of world configs (*.yaml).
UAS_WORLDS=worlds
# Comma-separated API keys per role. Spectators may read without a key when a world has publicRead: true.
UAS_ADMIN_KEYS=
UAS_VISITOR_KEYS=
UAS_SPECTATOR_KEYS=

# --- Brains (used by worlds/garden.yaml)
# models | autopilot
UAS_BRAIN=models
# Head of the decide/vocalize chain (local Laya always follows it): laya (hosted) | jev (hosted) | localDm (local Laya) | tev (local Tev1) | fake
UAS_DECIDER=laya
# appraise/scoreMemory: fake | localDm | local | small
UAS_SCORER=hostedText
# reflect during standby (local llama3.2 follows it): hostedText | luna | haiku | nemo | local | fakeChat
UAS_REFLECTOR=hostedText
# low-confidence plans (local qwen3.5 planner follows it): hostedText | luna | haiku | nemo | planner | fakeChat
UAS_PLANNER=hostedText

# --- Local models (Ollama). `npm run ollama:up && npm run ollama:pull`
OLLAMA_URL=http://localhost:11434

# --- Sign in with Vercel (optional). Create the app in the Vercel dashboard (team Settings > Apps >
# Create), enable scopes openid, email, profile, generate a client secret, and register exactly this
# authorization callback URL: ${UAS_PUBLIC_URL}/api/auth/callback (http://localhost:5173/api/auth/callback
# in dev; Vercel allows loopback http). Without a client id, login is unavailable and API keys still work.
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
# Vercel user ids (preferred) or usernames that are admins; every other signed-in user is a visitor.
UAS_ADMIN_VERCEL_USERS=
# Where the browser reaches the app (the Vite dev server proxies /api to the server).
UAS_PUBLIC_URL=http://localhost:5173
# Signs session cookies. Generated into .env on first run if missing; never logged.
UAS_SESSION_SECRET=

# --- Hosted models through Vercel AI Gateway (one key for all of them). Optional: without it,
# everything runs on local Ollama models and autopilot, with a single warning at startup.
# Never commit .env; the key is never logged.
AI_GATEWAY_API_KEY=
# Hard daily spend cap per world, in AUD (survives restarts). When reached, decisions use local Laya, then autopilot.
UAS_DAILY_CAP_AUD=0.5
# Hosted text model for plans, reflection and appraisal (AI Gateway id). Better: openai/gpt-6-luna;
# alternatives: anthropic/claude-haiku-5.5, mistral/mistral-nemo.
UAS_HOSTED_TEXT_MODEL=meta/llama-3.1-8b

# --- Cloud providers directly (optional; Vercel AI SDK)
ANTHROPIC_API_KEY=
# Other AI SDK providers (OpenAI, Google, OpenRouter) need their @ai-sdk package wired into
# packages/models/src/adapters/ai-sdk.ts before these do anything:
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# Jev (TypeSafe) adapter is a stub until its API is wired in:
# JEV_KEY=

# --- Tuning
# Safety-net in-world seconds to wait for a model answer (the queue normally answers or drops first).
UAS_JOB_TIMEOUT_SECONDS=300
# Drop a queued model job whose trigger is older than this many in-world seconds (character uses autopilot).
UAS_STALE_SECONDS=60
# World timezone (IANA name); empty = the server's system timezone. The garden's time of day follows it.
UAS_TIMEZONE=
# Decisions below this confidence escalate to the plan chain (UAS_PLANNER).
UAS_ESCALATE_BELOW=0.35
# Ask models to appraise/score each outcome (2 extra jobs per action). false = code appraisal.
UAS_APPRAISE=false
# Decision model tag for localDm (uas-laya is built by `npm run ollama:pull`).
UAS_DM_MODEL=uas-laya
# Tev1 alternative for UAS_DECIDER=tev (built by `UAS_PULL_TEV=1 npm run ollama:pull`).
UAS_TEV_MODEL=uas-tev1
# Text model for reflection (`local`).
UAS_TEXT_MODEL=llama3.2:1b
# Text model for plans (`planner`).
UAS_PLAN_MODEL=qwen3.5:0.8b

# --- Ollama CPU limits (scripts/ollama-up.sh, compose). Keep threads equal to the CPU cap.
OLLAMA_CPUS=4
OLLAMA_CPU_SHARES=256
OLLAMA_THREADS=4
